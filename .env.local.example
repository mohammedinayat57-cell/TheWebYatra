# ── Contact Form Email (SMTP) ──────────────────────────────────────────────
# Gmail example: use an App Password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Or use Resend (https://resend.com) for a simpler setup:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx

# The inbox that receives contact form submissions
CONTACT_EMAIL=hello@thewebyatra.com
